CLERK_ISSUER_URL=https://your-clerk-domain.clerk.accounts.dev
# Optional. Defaults to ${CLERK_ISSUER_URL}/.well-known/jwks.json
CLERK_JWKS_URL=
# Optional. Only set this if you configure an audience in Clerk JWT settings.
CLERK_JWT_AUDIENCE=
# Optional. Defaults to backend/data/lingodoc.db for local development.
DATABASE_PATH=
# Translation provider credentials.
OFOXAI_API_KEY=your_ofoxai_api_key_here
OFOXAI_BASE_URL=https://api.ofox.ai/v1
OFOXAI_MODEL=openai/gpt-5.4
# Optional. Default local plan before Paddle subscription sync exists.
DEFAULT_USER_PLAN=free
# Optional. Free users translate a preview of each PDF instead of blocking large files.
FREE_PREVIEW_PAGE_LIMIT=3
FREE_MAX_PAGES_PER_FILE=3
FREE_MAX_FILE_SIZE_MB=25
# 0 means no monthly cap for free preview usage. Each file still only translates the preview pages.
FREE_MONTHLY_PAGE_QUOTA=0
# Optional. Future paid-plan page caps. Set to 0 for unlimited.
STARTER_MAX_PAGES_PER_FILE=50
STARTER_MAX_FILE_SIZE_MB=50
STARTER_MONTHLY_PAGE_QUOTA=100
PRO_MAX_PAGES_PER_FILE=300
PRO_MAX_FILE_SIZE_MB=100
PRO_MONTHLY_PAGE_QUOTA=500
POWER_MAX_PAGES_PER_FILE=3000
POWER_MAX_FILE_SIZE_MB=250
POWER_MONTHLY_PAGE_QUOTA=3000
# Paddle Billing. Use sandbox values for local testing, then switch to live values for production.
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
# Optional. Used to sign short-lived PDF preview URLs. Falls back to Paddle/R2 secrets when unset.
PREVIEW_URL_SECRET=
# Optional. Defaults to backend as the local storage root.
LOCAL_STORAGE_ROOT=
# Optional. Use local for development or r2 for Cloudflare R2.
STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=r2.
R2_BUCKET=your-r2-bucket-name
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional. Defaults to backend/tmp/storage-cache for R2 local processing cache.
LOCAL_STORAGE_CACHE_DIR=
